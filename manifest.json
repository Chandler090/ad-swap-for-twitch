{
  "manifest_version": 3,
  "name": "Ad Swap for Twitch",
  "version": "0.44",
  "description": "During Twitch ad breaks that keep the stream in a mini player, shows the live stream in the main player. Switches back by itself.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://www.twitch.tv/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ad Swap for Twitch",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "cover-now": {
      "description": "Cover or uncover the Twitch player now"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "adswap.user.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "player.html",
        "player.js",
        "library.js",
        "schedule.js"
      ],
      "matches": [
        "https://www.twitch.tv/*"
      ]
    }
  ]
}
